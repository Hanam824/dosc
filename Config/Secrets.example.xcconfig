// Template for the git-ignored secrets files. Copy it to one or both of:
//   Config/Secrets.development.xcconfig   used by Debug builds
//   Config/Secrets.production.xcconfig    used by Release builds (CI writes this one itself)
// and fill in the values. A missing file or empty value turns the feature off.

// Client ID of a GitHub OAuth App with "Device Flow" enabled, for "Sign in with GitHub".
// Use a separate OAuth App for development and production if you want to keep them apart.
GITHUB_CLIENT_ID = Ov23liXXXXXXXXXXXXXX
